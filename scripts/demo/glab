def iso(ago):
    return time.strftime("%Y-%m-%dT%H:%M:%S.000+00:00", time.gmtime(time.time() - ago))

def mr(project_id, iid, project, title, author, pipeline, pid, status, ago, desc="", draft=False):
    return {
        "iid": iid, "project_id": project_id, "title": title, "state": "opened",
        "web_url": f"https://gitlab.example.com/{project}/-/merge_requests/{iid}",
        "head_pipeline": {"status": pipeline, "id": pid, "project_id": project_id,
                          "web_url": f"https://gitlab.example.com/{project}/-/pipelines/{pid}"},
        "detailed_merge_status": status, "author": {"username": author},
        "references": {"full": f"{project}!{iid}"}, "updated_at": iso(ago),
        "description": desc, "draft": draft,
    }


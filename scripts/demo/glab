def jobs(pid):
    plan = {
        9001: [("build", "build", "success", 74), ("lint", "test", "success", 31), ("unit", "test", "success", 128),
               ("integration", "test", "running", None), ("deploy-review", "deploy", "created", None)],
        9002: [("build", "build", "success", 92), ("lint", "test", "success", 25), ("unit", "test", "failed", 61),
               ("e2e", "test", "skipped", None)],
        9003: [("build", "build", "success", 55), ("test", "test", "success", 140), ("audit", "test", "success", 12)],
        9004: [("build", "build", "success", 210), ("test", "test", "running", None)],
        9005: [("plan", "build", "success", 48), ("validate", "test", "success", 20)],
    }[pid]
    return [{"id": pid * 10 + i, "name": n, "stage": s, "status": st, "duration": d, "allow_failure": False,
             "web_url": f"https://gitlab.example.com/jobs/{pid * 10 + i}"} for i, (n, s, st, d) in enumerate(plan)]

def approvers(iid):
    return ["maria.k"] if iid == 311 else []

def graphql(m):
    """The MR as GitLab's GraphQL API gives it."""
    p = m["head_pipeline"]
    host = "https://gitlab.example.com"
    upper = lambda s: s.upper() if s else None
    return {
        "iid": str(m["iid"]), "title": m["title"], "webUrl": m["web_url"], "state": m["state"],
        "draft": m["draft"], "updatedAt": m["updated_at"], "description": m["description"],
        "detailedMergeStatus": upper(m["detailed_merge_status"]), "author": m["author"],
        "project": {"id": f"gid://gitlab/Project/{m['project_id']}", "fullPath": m["references"]["full"].split("!")[0]},
        "approvedBy": {"nodes": [{"username": u} for u in approvers(m["iid"])]},
        "resolvableDiscussionsCount": len(THREADS.get(m["iid"], [])), "resolvedDiscussionsCount": 0,
        "headPipeline": {"status": upper(p["status"]), "path": p["web_url"][len(host):], "jobs": {"nodes": [
            {"id": f"gid://gitlab/Ci::Build/{j['id']}", "name": j["name"], "status": upper(j["status"]),
             "allowFailure": j["allow_failure"], "duration": j["duration"], "webPath": j["web_url"][len(host):],
             "stage": {"name": j["stage"]}} for j in jobs(p["id"])]}},
    }

def main(args):
    if args[:2] == ["mr", "view"]:
        repo = os.path.basename(os.getcwd())
        if repo in OWN:
            return OWN[repo]
        sys.exit(1)
    if args[:1] != ["api"] or len(args) < 2:
        sys.exit(1)
    path = args[1]
    if path == "graphql":
        query = args[3]
        for field, mrs in [("reviewRequestedMergeRequests", REVIEWS.values()),
                           ("authoredMergeRequests", OWN.values()),
                           # GitLab assigns your own MRs to you too.
                           ("assignedMergeRequests", [*OWN.values(), *ASSIGNED.values()])]:
            if field in query:
                return {"data": {"currentUser": {"username": "johe", field: {"nodes": [graphql(m) for m in mrs]}}}}
        sys.exit(1)
    if path.startswith("issues?"):
        return ISSUES
    parts = path.split("?")[0].split("/")
    if parts[0] == "projects" and parts[2] == "pipelines":
        return jobs(int(parts[3]))
    if parts[0] == "projects" and parts[2] == "merge_requests":
        if parts[4:5] == ["discussions"]:
            return THREADS.get(int(parts[3]), [])
    sys.exit(1)

print(json.dumps(main(sys.argv[1:])))
